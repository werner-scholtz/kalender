// The input for `fix_kalender_locale.yaml`. Run `dart fix --compare-to-golden test_fixes`.
//
// The bare `context.calendarLocale` below is deliberate: the transform cannot reach
// it, so the golden records that it is left alone.

import 'package:flutter/widgets.dart';
import 'package:kalender/kalender.dart';

Locale? namedExtension(BuildContext context) => KalenderLocale(context).kalenderLocale;
Locale? bareGetter(BuildContext context) => context.calendarLocale;
