# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/
/ios/

/examples/**/pubspec.lock

# fvm resolves .fvmrc into this symlinked directory.
.fvm/

# The root pin is a local choice. The examples pin the version they need.
/.fvmrc

# Written by tool/analyze_doc_snippets.dart on every run.
/examples/doc_snippets/lib/generated/

# Written by `flutter test --coverage`.
/coverage/
